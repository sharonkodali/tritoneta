# Copy to .env and fill in. .env is gitignored.

# --- San Diego MTS GTFS / GTFS-Realtime ---
# MTS serves realtime through its developer API, which requires a free key.
# Register at https://www.sdmts.com/business-center/app-developers and paste the key here.
# VERIFY these URLs against the current MTS developer docs before your first run —
# agencies move endpoints, and the poller will tell you loudly if a feed 404s.
MTS_API_KEY=

GTFS_STATIC_URL=https://www.sdmts.com/google_transit_files/google_transit.zip
GTFS_RT_VEHICLE_POSITIONS_URL=https://realtime.sdmts.com/api/api/gtfs_realtime/vehicle_positions
GTFS_RT_TRIP_UPDATES_URL=https://realtime.sdmts.com/api/api/gtfs_realtime/trip_updates

# How the key is passed. "query" appends ?key=..., "header" sends an Authorization header.
GTFS_RT_AUTH_STYLE=query
GTFS_RT_AUTH_PARAM=key

# --- local paths (relative to repo root unless absolute) ---
DATA_DIR=data
DUCKDB_PATH=data/warehouse.duckdb

# --- serving ---
MODEL_PATH=ml/artifacts/delay_model.joblib
API_HOST=127.0.0.1
API_PORT=8000
